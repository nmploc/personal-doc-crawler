# ==============================================================================
# CẤU HÌNH API VÀ MÔ HÌNH VLM
# ==============================================================================
# Người dùng phổ thông (mặc định 1 key)
GEMINI_API_KEY=your_gemini_api_key_here

# Dành cho nhà phát triển (Sử dụng luân phiên nhiều Free-Tier keys):
# Khai báo nhiều dòng GEMINI_API_KEY để hệ thống tự động fallback khi hết token (hoặc báo lỗi 429).
# GEMINI_API_KEY=Key_Thứ_1_cua_ban
# GEMINI_API_KEY=Key_Thứ_2_cua_ban
# GEMINI_API_KEY=Key_Thứ_3_cua_ban

GEMINI_MODEL=gemini-3.5-flash

VLM_TIMEOUT_SECONDS=45
ENABLE_RAG_METADATA=true

# ==============================================================================
# CẤU HÌNH PADDLEOCR / LOCAL ENGINES
# ==============================================================================
PADDLE_USE_GPU=false
PADDLE_LANG=vi
MARKITDOWN_CMD=markitdown
DOCLING_CMD=docling

# ==============================================================================
# THƯ MỤC XUẤT KẾT QUẢ
# ==============================================================================
OUTPUT_DIR=./output
