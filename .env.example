# ==============================================================================
# CẤU HÌNH API VÀ MÔ HÌNH VLM (GEMINI & QWEN VIA OPENROUTER / DASHSCOPE)
# ==============================================================================

# 1. Google Gemini API (Lấy tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# 2. Qwen2.5-VL API (Hỗ trợ OpenRouter, Alibaba DashScope, vLLM, Ollama)
# Nếu dùng OpenRouter (Lấy key tại https://openrouter.ai/keys):
QWEN_VL_API_KEY=sk-or-v1-...
QWEN_VL_BASE_URL=https://openrouter.ai/api/v1
QWEN_VL_MODEL=qwen/qwen2.5-vl-72b-instruct:free
QWEN_VL_FALLBACK_MODEL=qwen/qwen2.5-vl-32b-instruct:free

# Hoặc nếu dùng Alibaba DashScope API:
# QWEN_VL_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_VL_MODEL=qwen2.5-vl-72b-instruct

# ==============================================================================
# CẤU HÌNH CHẾ ĐỘ ĐỐI CHIẾU VÀ TỰ ĐỘNG CHUYỂN VÙNG (DUAL-VLM CROSS-CHECK)
# ==============================================================================
# - "parallel": Chạy song song cả Qwen và Gemini đối chiếu chéo (Auto-Failover)
# - "fallback": Thử Qwen trước, nếu lỗi tự động chuyển sang Gemini
# - "qwen_only": Chỉ dùng Qwen2.5-VL verify
# - "gemini_only": Chỉ dùng Gemini 3.5 Flash verify
VLM_VERIFY_MODE=parallel
VLM_TIMEOUT_SECONDS=45
ENABLE_RAG_METADATA=true

# ==============================================================================
# CẤU HÌNH PADDLEOCR / LOCAL ENGINES
# ==============================================================================
PADDLE_USE_GPU=false
PADDLE_LANG=vi
MARKITDOWN_CMD=markitdown
DOCLING_CMD=docling

# ==============================================================================
# THƯ MỤC XUẤT KẾT QUẢ
# ==============================================================================
OUTPUT_DIR=./output
